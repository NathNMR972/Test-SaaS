# Copiez ce fichier en ".env.local" pour développer en local (jamais nécessaire
# pour le fondateur : ces valeurs se collent uniquement dans Vercel, voir
# docs/guide-demarrage.md). Ne jamais mettre de vraies valeurs dans ce fichier
# ni dans un fichier suivi par git.

# Réglages > API du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (Réglages > API > service_role) — jamais exposée au navigateur,
# utilisée uniquement dans le code qui tourne sur le serveur.
SUPABASE_SERVICE_ROLE_KEY=
